jquery-[0-9]*.js
bootstrap-[0-9]*.js*
bootstrap-[0-9]*.css*
backend/static/styles/bootstrap.*.css*
*.code-workspace
secrets/
# `make worktree-init` links secrets in as a symlink, which the dir-only pattern above does not match
/secrets
backups/
*.gz*
node_modules/
gen/
*.bak
logs/
plans/
reviews/
changelog/
tmp/
.playwright-mcp
.claude/worktrees/
