# ---------------------------------------------------------------------------
# Required keys (local Docker + tests) — dummy local-only values
# ---------------------------------------------------------------------------
# Copy this file to .env and fill/change these before `make setup`. The values
# below are placeholders for a local stack only; never reuse them elsewhere.
# The hub `db` publishes no host port, so the dummy password is reachable only
# on the hub's Docker network.
SECRET_KEY=change-me-local-only
POSTGRES_USER=u4i
POSTGRES_PASSWORD=change-me-local-only
# Locally overridden by compose to u4i_dev_<slug>.
POSTGRES_DB=u4i_dev
# Must not start with u4i_dev, must differ from the per-worktree dev DB, and
# must not be a system DB (scripts/testrun_resources.py, docker/db-provision.sh).
POSTGRES_TEST_DB=u4i_test
# Dummies boot the app (backend/config.py checks `is None`); real sends fail
# with 401 / ERROR_WITH_MAILJET.
MAILJET_API_KEY=dummy-mailjet-api-key
MAILJET_SECRET_KEY=dummy-mailjet-secret-key
# Uncomment to skip real email sends in local flows (backend/config.py).
# MOCK_EMAIL_SEND=true

# ---------------------------------------------------------------------------
# OAuth provider credentials (Google + GitHub)
# ---------------------------------------------------------------------------
# ALL FOUR keys below are OPTIONAL. Leave them empty and the app boots normally
# with OAuth disabled — no ValueError is raised for a missing key. Populate them
# only when you want to enable "Sign in with Google" / "Sign in with GitHub".
#
# Register a SEPARATE OAuth client per environment (local / dev / prod) so a
# leaked credential in one environment can never authorize a callback in another.
#
# Callback URLs are generated by the app via url_for(<callback>, _external=True)
# (the public scheme + host come from the ProxyFix middleware) — there is no
# callback-URL env var to set. Register the resulting URL on each provider's
# console. Local callback URLs to register:
#   Google: http://127.0.0.1:8659/oauth/google/callback
#   GitHub: http://127.0.0.1:8659/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
API_ACCESS_TOKEN_LIFETIME_SECONDS=900
API_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
