><span class="step-event" aria-label="POST .../urls" title="POST .../urls">POST .../urls</span></div><span class="step-count">150</span><span class="step-pct">75%</span></div><div class="funnel-connector" aria-label="10 drop-off"><div class="arrow-row"><span class="arrow" aria-hidden="true">↓</span><span class="arrow-dropoff">10 drop-off</span></div><div class="causes"><div class="cause-pill reject" style="--w: 80%;" aria-label="invalid_url: 8"><span class="cause-label">invalid_url</span><span class="cause-count">8</span></div><div class="cause-pill reject" style="--w: 20%;" aria-label="url_already_in_utub: 2"><span class="cause-label">url_already_in_utub</span><span class="cause-count">2</span></div></div></div><div class="funnel-step domain" style="--w: 70%;"><span class="step-kind">Domain</span><div class="step-labels"><span class="step-label">URL added</span><span class="step-event" aria-label="url_added_to_utub" title="url_added_to_utub">url_added_to_utub</span></div><span class="step-count">140</span><span class="step-pct">70%</span></div></div></section>"`;
