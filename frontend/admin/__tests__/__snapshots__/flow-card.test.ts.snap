// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderFlowGrid > renders the four built-in cards with a stable DOM snapshot 1`] = `"<section class="flow-card" data-flow-id="create_utub" aria-label="Create UTub: 140 of 200 succeeded, 70% conversion"><div class="flow-header"><h3 class="flow-title">Create UTub</h3><span class="flow-summary">140 / 200 succeeded · 70% conversion</span></div><div class="funnel"><div class="funnel-step ui" style="--w: 100%;"><span class="step-kind">UI</span><div class="step-labels"><span class="step-label">Open URL form</span><span class="step-event" aria-label="ui_url_create_open" title="ui_url_create_open">ui_url_create_open</span></div><span class="step-count">200</span><span class="step-pct">100%</span></div><div class="funnel-connector" aria-label="40 drop-off"><div class="arrow-row"><span class="arrow" aria-hidden="true">↓</span><span class="arrow-dropoff">40 drop-off</span></div><div class="causes"><div class="cause-pill cancel" style="--w: 75%;" aria-label="escape_key: 30"><span class="cause-label">escape_key</span><span class="cause-count">30</span></div><div class="cause-pill cancel" style="--w: 25%;" aria-label="outside_click: 10"><span class="cause-label">outside_click</span><span class="cause-count">10</span></div></div></div><div class="funnel-step ui" style="--w: 80%;"><span class="step-kind">UI</span><div class="step-labels"><span class="step-label">Submit</span><span class="step-event" aria-label="ui_form_submit" title="ui_form_submit">ui_form_submit</span></div><span class="step-count">160</span><span class="step-pct">80%</span></div><div class="funnel-connector" aria-label="10 drop-off"><div class="arrow-row"><span class="arrow" aria-hidden="true">↓</span><span class="arrow-dropoff">10 drop-off</span></div></div><div class="funnel-step api" style="--w: 75%;"><span class="step-kind">API</span><div class="step-labels"><span class="step-label">POST .../urls</span><span class="step-event" aria-label="POST .../urls" title="POST .../urls">POST .../urls</span></div><span class="step-count">150</span><span class="step-pct">75%</span></div><div class="funnel-connector" aria-label="10 drop-off"><div class="arrow-row"><span class="arrow" aria-hidden="true">↓</span><span class="arrow-dropoff">10 drop-off</span></div><div class="causes"><div class="cause-pill reject" style="--w: 80%;" aria-label="invalid_url: 8"><span class="cause-label">invalid_url</span><span class="cause-count">8</span></div><div class="cause-pill reject" style="--w: 20%;" aria-label="url_already_in_utub: 2"><span class="cause-label">url_already_in_utub</span><span class="cause-count">2</span></div></div></div><div class="funnel-step domain" style="--w: 70%;"><span class="step-kind">Domain</span><div class="step-labels"><span class="step-label">URL added</span><span class="step-event" aria-label="url_added_to_utub" title="url_added_to_utub">url_added_to_utub</span></div><span class="step-count">140</span><span class="step-pct">70%</span></div></div></section><section class="flow-card" data-flow-id="add_url_to_utub" aria-label="Add URL to UTub: 140 of 200 succeeded, 70% conversion"><div class="flow-header"><h3 class="flow-title">Add URL to UTub</h3><span class="flow-summary">140 / 200 succeeded · 70% conversion</span></div><div class="funnel"><div class="funnel-step ui" style="--w: 100%;"><span class="step-kind">UI</span><div class="step-labels"><span class="step-label">Open URL form</span><span class="step-event" aria-label="ui_url_create_open" title="ui_url_create_open">ui_url_create_open</span></div><span class="step-count">200</span><span class="step-pct">100%</span></div><div class="funnel-connector" aria-label="40 drop-off"><div class="arrow-row"><span class="arrow" aria-hidden="true">↓</span><span class="arrow-dropoff">40 drop-off</span></div><div class="causes"><div class="cause-pill cancel" style="--w: 75%;" aria-label="escape_key: 30"><span class="cause-label">escape_key</span><span class="cause-count">30</span></div><div class="cause-pill cancel" style=