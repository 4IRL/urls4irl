# syntax=docker/dockerfile:1.5
FROM python:3.11.14-slim-bookworm
LABEL org.opencontainers.image.source="https://github.com/4IRL/urls4irl"

# Some environment variable handling
ENV FLASK_APP=run \
	PYTHONUNBUFFERED=1 \
	PIP_DISABLE_PIP_VERSION_CHECK=1 \
	LOG_DIR=/app/volume/logs

# Use code as working directory
WORKDIR /code/u4i
RUN chmod -R 775 /code

# Update packages, clean up
RUN set -ex \
	&& apt-get update \
	&& apt-get -y install libpq-dev gcc wget unzip xvfb libglib2.0-dev libnss3-dev libdbus-1-dev  libatk1.0-0 libatk-bridge2.0-0 libcups2 libxkbcommon-dev libxcomposite-dev libxdamage-dev libgbm-dev libpangocairo-1.0-0 libasound2 \
	&& apt-get upgrade -y \
	&& apt-get autoremove -y \
	&& apt-get clean -y \
	&& rm -rf /var/lib/apt/lists/*

# Copy requirements files install dependencies
COPY requirements/ ./requirements/

# Install development level requirements
RUN --mount=type=cache,target=/root/.cache/pip \
	python3 -m venv /code/venv \
	&& . /code/venv/bin/activate \
	&& pip install -r requirements/requirements-dev.txt

# Create the non-root user with the host's UID/GID (build args fed by compose from
# docker/.capacity.generated.env) so bind-mounted files keep host ownership. Declared after pip so a
# UID change keeps the pip layer cached. --non-unique tolerates an id the base image already uses
# (e.g. macOS gid 20 = Debian's dialout). Home/shell mirror a Debian `adduser --system` user.
# An id of 0 (host running as root) falls back to 1001 so u4i-host never aliases root.
ARG HOST_UID=1001
ARG HOST_GID=1001
RUN if [ "$HOST_UID" = 0 ]; then echo "HOST_UID=0 (root): using 1001"; HOST_UID=1001; fi \
	&& if [ "$HOST_GID" = 0 ]; then echo "HOST_GID=0 (root): using 1001"; HOST_GID=1001; fi \
	&& groupadd --non-unique --gid "$HOST_GID" u4i-host-group \
	&& useradd --non-unique --system --uid "$HOST_UID" --gid u4i-host-group \
		--home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin u4i-host

# Copy files needed
COPY --chown=u4i-host:u4i-host-group docker/startup-flask.sh ./
COPY --chown=u4i-host:u4i-host-group run.py ./
COPY --chown=u4i-host:u4i-host-group backend/ ./backend/
COPY --chown=u4i-host:u4i-host-group migrations/ ./migrations/
COPY --chown=u4i-host:u4i-host-group tests/ ./tests/
COPY --chown=u4i-host:u4i-host-group scripts/ ./scripts/
COPY --chown=u4i-host:u4i-host-group pytest.ini ./

# Create necessary directories with proper permissions
RUN mkdir -p /app/volume/logs /code/u4i/backend/gen \
	&& chmod -R 775 /code /app/volume/logs \
	&& chmod -R 777 /code/u4i/backend/gen \
	&& chown -R u4i-host:u4i-host-group /code /app/volume/logs /code/u4i/backend/gen

# Add custom shell entrypoint that activates the venv
RUN echo '#!/bin/bash\nsource /code/venv/bin/activate\nexec bash --rcfile <(echo "source /code/venv/bin/activate")' > /usr/local/bin/venvshell \
    && chmod +x /usr/local/bin/venvshell

# Create a non-root user
USER u4i-host

# Expose a port to access the container
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider --no-check-certificate http://localhost:5000/health || exit 1

CMD ["bash", "startup-flask.sh"]
