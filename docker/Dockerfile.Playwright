# syntax=docker/dockerfile:1.6
# 1.6, not the repo's usual 1.5 (Dockerfile/Dockerfile.Local/Dockerfile.Vite/Dockerfile.Workflow): only
# 1.6+ frontends recognize HEALTHCHECK's --start-interval flag, used below.
#
# Hub `playwright` browser server (docker/compose.hub.yaml). Build context is docker/, so the repo root is
# never shipped. The entrypoint supervises `playwright run-server` and exits 0 after
# U4I_PLAYWRIGHT_IDLE_MINUTES with no clients (see docker/playwright-entrypoint.sh).

# One source for the version: keep in lockstep with requirements/requirements-test.txt (unit-tested).
ARG PLAYWRIGHT_VERSION=1.60.0
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble
ARG PLAYWRIGHT_VERSION
# Browsers are already in /ms-playwright; install only the CLI so a start never hits the npm registry.
RUN npm install -g --ignore-scripts playwright@${PLAYWRIGHT_VERSION} && npm cache clean --force
COPY --chmod=0755 playwright-entrypoint.sh /usr/local/bin/u4i-playwright-entrypoint
USER pwuser
WORKDIR /home/pwuser
# Mirrors Dockerfile.Workflow's HEALTHCHECK-mirrors-compose-healthcheck convention (see its :101-102).
# Same probe literal as docker/playwright-lifecycle-test.sh's probe() and compose.hub.yaml's healthcheck
# test:, byte-identical, and the same interval/timeout/retries/start-period/start-interval as the compose
# healthcheck — keep all three in lockstep on any edit (enforced by tests/unit/test_compose_hub.py's
# test_playwright_dockerfile_healthcheck_matches_compose and
# test_lifecycle_harness_probe_matches_compose_healthcheck). --start-interval needs BuildKit/engine >= 25.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=60s --start-interval=1s \
    CMD node -e "require('net').connect(3000,'127.0.0.1').on('connect',function(){process.exit(0)}).on('error',function(){process.exit(1)})"
ENTRYPOINT ["/usr/local/bin/u4i-playwright-entrypoint"]
# Explicit empty CMD: never inherit the base image's CMD ["/bin/bash"] as the entrypoint's $1.
CMD []
