# syntax=docker/dockerfile:1.5
FROM node:24.18.0-bookworm-slim

WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Pinned pnpm (must match .mise.toml; enforced by `make mise-config-check`). Installed via npm
# rather than corepack, which Node 25 removes.
ARG PNPM_VERSION=11.9.0
RUN npm install -g --ignore-scripts pnpm@${PNPM_VERSION}

# Copy package manifest, lockfile and pnpm config (overrides, allowBuilds, release-age excludes)
COPY ./frontend/package.json ./frontend/pnpm-lock.yaml ./frontend/pnpm-workspace.yaml ./

# Compose runs this container as the host's HOST_UID:HOST_GID (build args + `user:` in compose.local.yaml, image
# default 1001), so the vite build writes backend/static/dist into the bind mount owned by you, not root (a root-owned
# dist blocks `git worktree remove`). /app is re-owned in the install layer, so the non-root user can write vite's
# config temp file (/app/node_modules/.vite-temp) and dev deps cache. /app/frontend/node_modules is pre-created so the
# anonymous volume masking it starts out with that ownership (a new volume copies the image dir's owner).
ARG HOST_UID=1001
ARG HOST_GID=1001
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile \
	&& mkdir -p /app/frontend/node_modules \
	&& chown -R "$HOST_UID:$HOST_GID" /app

# A HOST_UID with no passwd entry would get HOME=/, which it cannot write (pnpm keeps state under $HOME).
ENV HOME=/tmp

# Expose Vite port
EXPOSE 5173

# Start Vite dev server with host 0.0.0.0 to allow Docker networking
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]
